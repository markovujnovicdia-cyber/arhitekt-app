# Store real values on the server only. Never commit .env.
OPENAI_API_KEY=
# Generate a random device-access credential, at least 32 characters:
# openssl rand -hex 32
DEVICE_ACCESS_TOKEN=
# Only bind publicly behind a TLS reverse proxy with upload/time limits.
HOST=127.0.0.1
PORT=8080
TRANSCRIPTION_MODEL=gpt-4o-transcribe
ANALYSIS_MODEL=gpt-4.1-mini
# Provider timeout applies independently to each chunk / analysis request.
PROVIDER_TIMEOUT_MS=120000
# For a managed Node24 environment with inherited proxy/CA trust:
# NODE_USE_ENV_PROXY=1
